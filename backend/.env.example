# SkillBridge AI Environment Variables
# Copy this file to .env and configure the keys

# Groq Cloud API Key (Get a free key at https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_goes_here

# Allowed origins for CORS (comma-separated list, no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend port configuration (optional)
PORT=8000
